spring.application.name=financetracker

spring.h2.console.enabled=true

jwt.secret=your_JWT_secret_256_bits_required
jwt.expiration=86400000

spring.datasource.url=jdbc:mysql://localhost:3306/financetracker
spring.datasource.username=your_db_username #generate with: openssl rand -base64 32
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
springdoc.swagger-ui.path=/swagger-ui.html